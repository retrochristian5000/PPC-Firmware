#
#  OpenBIOS Makefile
# (C) 2004-2009 by the OpenBIOS team
#

include config.mak

# Generated firmware ABI flags are independent of parent Make assignments.
# Keep compatibility with existing config.mak files until reconfiguration.
ifneq ($(origin OPENBIOS_CONFIG_CFLAGS),undefined)
override CFLAGS := $(OPENBIOS_CONFIG_CFLAGS)
override AS_FLAGS := $(OPENBIOS_CONFIG_AS_FLAGS)
endif

# QEMU invokes sub-makes with -rR, which clears the built-in suffix list.
# Restore the suffixes used by OpenBIOS's generated compilation rules.
.SUFFIXES: .c .S .o .d

override ODIR := .
HOSTCC ?= cc
HOSTAR ?= ar
HOSTRANLIB ?= ranlib

# Upstream historically hard-coded HOSTCC=gcc, so its warning list contains
# GCC-specific diagnostics. This fork permits Clang host tools; only pass a
# warning option when the selected host compiler accepts it under -Werror.
host-cc-option = $(shell printf 'int openbios_host_warning_probe;\n' | $(HOSTCC) -Werror $(1) -x c -fsyntax-only - >/dev/null 2>&1 && printf '%s' '$(1)')

override HOSTCFLAGS += -O2 -g -DFCOMPILER -DBOOTSTRAP $(CROSSCFLAGS)
override HOSTCFLAGS += -Wall -Wredundant-decls -Wshadow -Wpointer-arith
override HOSTCFLAGS += -Wstrict-prototypes -Wmissing-declarations -Wundef -Wendif-labels
override HOSTCFLAGS += -Wstrict-aliasing -Wwrite-strings -Wmissing-prototypes -Wnested-externs
override HOSTCFLAGS += -Wimplicit-fallthrough -Woverride-init
override HOSTCFLAGS += $(call host-cc-option,-Wno-maybe-uninitialized)
override HOSTCFLAGS += $(call host-cc-option,-Wbuiltin-declaration-mismatch)
override HOSTCFLAGS += -W
HOSTINCLUDES := -I$(SRCDIR)/include -I$(SRCDIR)/kernel -I$(SRCDIR)/kernel/include -iquote $(ODIR)/target/include

# Cross tools are selected by switch-arch. Parent make command-line
# assignments must not replace them with the host toolchain.
ifneq ($(strip $(TARGET)),)
override CC     := $(TARGET)gcc
override AR     := $(TARGET)ar
override LD     := $(TARGET)ld
override NM     := $(TARGET)nm
override STRIP  := $(TARGET)strip
override RANLIB := $(TARGET)ranlib
else
CC     := $(TARGET)gcc
AR     := $(TARGET)ar
LD     := $(TARGET)ld
NM     := $(TARGET)nm
STRIP  := $(TARGET)strip
RANLIB := $(TARGET)ranlib
endif

# PPC OpenBIOS has historically been sensitive to optimizer and compiler
# changes. Keep optimization policy local to the firmware build instead of
# inheriting it from QEMU, the shell environment, or a distribution build.
ifeq ($(ARCH),ppc)
OPENBIOS_TARGET_OPTIMIZATION ?= -O0

ifneq ($(words $(OPENBIOS_TARGET_OPTIMIZATION)),1)
$(error OPENBIOS_TARGET_OPTIMIZATION must contain exactly one optimization flag)
endif
ifeq ($(filter $(OPENBIOS_TARGET_OPTIMIZATION),-O0 -O1 -O2 -O3 -Os -Og),)
$(error OPENBIOS_TARGET_OPTIMIZATION must be one of -O0, -O1, -O2, -O3, -Os, or -Og)
endif

# Remove code-generation policy that can leak in from a parent make or command
# line. The PowerPC ABI flags generated by switch-arch remain intact.
OPENBIOS_PPC_UNSAFE_FLAGS := -O% -flto% -fuse-linker-plugin -fprofile% \
	-fauto-profile% -fwhole-program -fpic -fPIC -fpie -fPIE -pie \
	-fstrict-aliasing
override CFLAGS := $(filter-out $(OPENBIOS_PPC_UNSAFE_FLAGS),$(CFLAGS))
override CFLAGS += $(OPENBIOS_TARGET_OPTIMIZATION) -fno-strict-aliasing

# The 32-bit entry path does not initialize EABI/SysV small-data base
# registers. Linux-targeted GCC builds may also default to PIE/PIC. Keep the
# ROM strictly freestanding so QEMU can enter it at its linked physical
# address without r2/r13, GOT, or dynamic-relocation dependencies.
override CFLAGS += -ffreestanding -mcall-sysv-noeabi -msdata=none -G0 -fno-pic -fno-pie
else
override CFLAGS += -Os
endif

override CFLAGS += -g -DNATIVE_BITWIDTH_EQUALS_HOST_BITWIDTH -USWAP_ENDIANNESS
override CFLAGS += -Wall -Wredundant-decls -Wshadow -Wpointer-arith
override CFLAGS += -Wstrict-prototypes -Wmissing-declarations -Wundef -Wendif-labels
override CFLAGS += -Wstrict-aliasing -Wwrite-strings -Wmissing-prototypes -Wnested-externs
override CFLAGS += -Wbuiltin-declaration-mismatch -Wimplicit-fallthrough -Woverride-init -Wno-maybe-uninitialized
override CFLAGS += -Werror
INCLUDES := -I$(SRCDIR)/include -I$(SRCDIR)/kernel/include -I$(ODIR)/target/include
override AS_FLAGS += -g

# Dependency options are compile-rule state, not global compiler policy.
# Keep this recursively expanded so automatic variables are resolved for the
# current object target rather than while Makefile.target is parsed.
DEPFLAGS = -MMD -MP -MT $@ -MF '$(@:.o=.d)'

# FCode tokeniser. switch-arch records an explicitly selected executable in
# config.mak; standalone builds retain the historical PATH-based default.
TOKE ?= toke

quiet-command = $(if $(V),$1,$(if $(2),@echo $2 && $1, @$1))

VPATH_SUFFIXES = %.c %.h %.S %.fs
set-vpath = $(if $1,$(foreach PATTERN,$(VPATH_SUFFIXES),$(eval vpath $(PATTERN) $1)))
$(call set-vpath, $(SRCDIR))

#
# pre rules
#

all: versions dictionaries host-libraries target-libraries host-executables target-executables

versions: $(ODIR)/target/include/openbios-version.h $(ODIR)/forth/version.fs

$(ODIR)/forth/version.fs:
	$(call quiet-command,true, "  GEN   $(TARGET_DIR)$@")
	@DATE="$(shell echo `LC_ALL=C TZ=UTC date +'%b %e %Y %H:%M'`)" ;  \
		( echo ": builddate \" $$DATE\" ; " ;     \
		  echo ": version \" $(VERSION)\" ; " ; ) \
		  > $(dir $@)/version.fs

$(ODIR)/target/include/openbios-version.h:
	$(call quiet-command,true, "  GEN   $(TARGET_DIR)$@")
	@DATE="$(shell echo `LC_ALL=C TZ=UTC date +'%b %e %Y %H:%M'`)" ; \
          ( echo "#define OPENBIOS_BUILD_DATE \"$$DATE\"" ; \
           echo "#define OPENBIOS_VERSION_STR \"$(VERSION)\"" ; ) \
         > $(dir $@)/openbios-version.h

info:
	@echo "Building OpenBIOS on $(HOSTARCH) for $(ARCH)"
	@echo "Target compiler: $(CC)"
	@echo "FCode tokenizer: $(TOKE)"
	@echo "Target optimization: $(if $(filter ppc,$(ARCH)),$(OPENBIOS_TARGET_OPTIMIZATION),-Os)"
	@echo "Target CFLAGS: $(CFLAGS)"

clean:
	@printf "Cleaning up for $(ARCH)..."
	@rm -rf forth.dict.core forthstrap *.dict openbios-*
	@rm -f $(ODIR)/target/include/openbios-version.h $(ODIR)/forth/version.fs
	@find . -type f \( -name "*~" -o -name '*.o' -o -name '*.d' -o -name '*.a' \) -exec rm \{\} \;
	@echo " ok"

build-verbose: info build

build: all

include rules.mak

# Include automatically generated dependency files
-include $(wildcard $(ODIR)/*.d $(ODIR)/host/kernel/*.d $(ODIR)/target/*/*.d $(ODIR)/target/*/*/*.d $(ODIR)/target/*/*/*/*.d)
