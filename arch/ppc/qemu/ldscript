OUTPUT_FORMAT(elf32-powerpc)
OUTPUT_ARCH(powerpc:common)
ENTRY(_start)

/* Initial load address
 */
BASE_ADDR = 0xfff00000;

/* As NVRAM is at 0xfff04000, the .text needs to be after that
 */
TEXT_ADDR = 0xfff08000;

/* Hard reset vector address
 */
HRESET_ADDR = 0xfffffffc;

CSTACK_SIZE = 32768;	/* client stack size */

/*
 * Keep the PowerPC PROM program-header ABI stable across linkers without
 * making writable firmware executable.  LLD already separates these
 * permission domains naturally; make them explicit so text remains RX,
 * constants remain R, mutable data remains RW, and the hard-reset branch
 * remains a detached RX load at the final four bytes of the address space.
 */
PHDRS
{
    text PT_LOAD FLAGS(5);
    rodata PT_LOAD FLAGS(4);
    data PT_LOAD FLAGS(6);
    reset PT_LOAD FLAGS(5);
}

SECTIONS
{
    . = BASE_ADDR;

    _start = BASE_ADDR + 0x0100;
    .text.vectors ALIGN(4096): {
        *(.text.vectors)
    } :text

    . = TEXT_ADDR;
    /* Normal sections */
    .text ALIGN(4096): {
        *(.text)
        *(.text.*)
    } :text

    .rodata ALIGN(4096): {
        _rodata = .;
	*(.rodata)
	*(.rodata.*)
        *(.note.ELFBoot)
    } :rodata
    .data ALIGN(4096): {
        _data = .;
        *(.data)
        *(.data.*)
	_edata = .;
    } :data

    .bss ALIGN(4096): {
        _bss = .;
	*(.sbss)
	*(.sbss.*)
	*(.bss)
	*(.bss.*)
	*(COMMON)
	_ebss = .;
    } :data

    /* _end describes the normal firmware payload.  The hard-reset vector is
     * detached at the final four bytes of the 32-bit address space, so
     * aligning after it would create 0x100000000 and wrap _end to zero in an
     * ELF32 symbol table. */
    _end = .;
    ASSERT(_end <= HRESET_ADDR, "OpenBIOS payload overlaps hard reset vector")

    . = HRESET_ADDR;

    .romentry : { *(.romentry) } :reset

    /* We discard .note sections other than .note.ELFBoot,
     * because some versions of GCC generates useless ones. */

    /DISCARD/ : { *(.comment*) *(.note.*) }
}
